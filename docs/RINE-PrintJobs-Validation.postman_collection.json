    {
      "name": "PrintJobs - 200 valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Devuelve pending + id\", function () {",
              "  const r = pm.response.json();",
              "  pm.expect(r.status).to.eql(\"pending\");",
              "  pm.expect(r).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"4\",\n  \"client_code\": \"05451\",\n  \"client_name\": \"REPUESJOR SRL\",\n  \"payload\": {\n    \"order_number\": \"PED-2026-00045\",\n    \"address\": \"Av. Colon 1234\",\n    \"city\": \"Mar del Plata\",\n    \"items\": [\n      { \"descripcion\": \"Filtro de aceite\", \"cantidad\": \"2\" },\n      { \"descripcion\": \"Correa distribucion\", \"cantidad\": \"1\" }\n    ],\n    \"total\": \"185000.50\",\n    \"remito_id\": \"REM-000987\",\n    \"fecha\": \"2026-03-17\"\n  },\n  \"number_of_copies\": \"1\"\n}"
        },
