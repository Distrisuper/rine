# API
APP_NAME=RINE Print Manager
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Invoice API
INVOICE_BASE_URL=http://invoice-api:8080

# Logging
LOG_LEVEL=INFO
RINE_MOCK_PRINTERS=1
ADMIN_USERNAME=admin
ADMIN_SECURITY_CODE=CAMBIAR_ADMIN_CODE

# CUPS (impresión). En Windows sin CUPS en el host: usar CUPS en Docker y definir:
# CUPS_SERVER=cups:631
# En Raspberry con CUPS en el host, no definir CUPS_SERVER (se usa el socket /var/run/cups).
CUPS_SERVER=cups:631

# S3 - Fricrot Remitos (PDF pre-generados)
S3_REMITOS_FRIC_ROT_BASE_URL=

#database
DATABASE_URL=sqlite:////app/.data/rine.db
DATABASE_URL_TEST=sqlite:////app/.data/rine_test.db
